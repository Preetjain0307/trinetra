# TRINETRA Environment Configuration
PROJECT_NAME="TRINETRA"
VERSION="1.0.0-sih-prototype"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database
# Default to SQLite for seamless zero-setup Windows execution; support PostgreSQL seamlessly
DATABASE_URL="sqlite:///./trinetra.db"
# Example PostgreSQL: DATABASE_URL="postgresql://trinetra_user:trinetra_pass@localhost:5432/trinetra_db"

# Security
JWT_SECRET="trinetra_sih_super_secure_jwt_secret_key_2026_change_in_production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=480

# CORS Origins (comma-separated or list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Storage Directories (relative or absolute)
DATA_DIR="./data"
VIDEO_DIR="./data/videos"
EVIDENCE_DIR="./data/evidence"
DEMO_DIR="./data/demo"

# AI / Vision settings
AI_MODEL_NAME="yolov8n.pt"
AI_CONFIDENCE_THRESHOLD=0.35
AI_TRACK_CONFIDENCE=0.45
AI_INFERENCE_FPS=5
AI_ENABLE_GPU=false

# Mode / Network
OPERATIONAL_MODE="NORMAL" # NORMAL, LOW_BANDWIDTH, OFFLINE
